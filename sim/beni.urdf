<?xml version="1.0"?>
<!-- Beni Prototype 1.  Generated from the Fusion model by
     beni_export.export_urdf(); masses and inertias are the
     model's own, not estimates.
     Frame: X forward, Y left, Z up.  All joints rotate about +Y.
     The knee is PASSIVE: the limits below are the mechanical
     stops, and the spring must be supplied by the simulator as
     a joint spring of ~10.45 N/mm acting through the cartridge
     moment arm (22.09 mm at -8 deg rising to 31.56 mm at +27).
-->
<robot name="beni_prototype1">

  <link name="base_link">
    <inertial>
      <origin xyz="-0.011033 -0.000000 0.013283" rpy="0 0 0"/>
      <mass value="1.628720"/>
      <inertia ixx="0.002838802" iyy="0.002627748" izz="0.002774378" ixy="0.000000000" iyz="-0.000000000" ixz="0.000385413"/>
    </inertial>
  </link>

  <link name="l_thigh">
    <inertial>
      <origin xyz="0.037853 0.017628 -0.031797" rpy="0 0 0"/>
      <mass value="0.222429"/>
      <inertia ixx="0.000406136" iyy="0.000745561" izz="0.000444612" ixy="-0.000086953" iyz="0.000081366" ixz="0.000318398"/>
    </inertial>
  </link>
  <joint name="l_shoulder" type="revolute">
    <parent link="base_link"/>
    <child link="l_thigh"/>
    <origin xyz="0.000000 0.052500 0.000000" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.228859" upper="3.228859" effort="25.0" velocity="30.0"/>
  </joint>

  <link name="l_shank">
    <inertial>
      <origin xyz="-0.064474 0.003129 -0.056064" rpy="0 0 0"/>
      <mass value="0.410591"/>
      <inertia ixx="0.000483486" iyy="0.001103798" izz="0.000685575" ixy="0.000027453" iyz="0.000019943" ixz="-0.000465239"/>
    </inertial>
  </link>
  <joint name="l_knee" type="revolute">
    <parent link="l_thigh"/>
    <child link="l_shank"/>
    <origin xyz="0.091925 0.022000 -0.077135" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.139626" upper="0.471239" effort="25.0" velocity="30.0"/>
  </joint>

  <link name="l_wheel">
    <inertial>
      <origin xyz="0.000000 0.004911 0.000000" rpy="0 0 0"/>
      <mass value="0.207060"/>
      <inertia ixx="0.000213508" iyy="0.000373144" izz="0.000213508" ixy="-0.000000000" iyz="0.000000000" ixz="0.000000000"/>
    </inertial>
  </link>
  <joint name="l_wheel" type="continuous">
    <parent link="l_shank"/>
    <child link="l_wheel"/>
    <origin xyz="-0.091925 0.009500 -0.077135" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="r_thigh">
    <inertial>
      <origin xyz="0.037853 -0.017628 -0.031797" rpy="0 0 0"/>
      <mass value="0.222429"/>
      <inertia ixx="0.000406136" iyy="0.000745561" izz="0.000444612" ixy="0.000086953" iyz="-0.000081366" ixz="0.000318398"/>
    </inertial>
  </link>
  <joint name="r_shoulder" type="revolute">
    <parent link="base_link"/>
    <child link="r_thigh"/>
    <origin xyz="0.000000 -0.052500 0.000000" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.228859" upper="3.228859" effort="25.0" velocity="30.0"/>
  </joint>

  <link name="r_shank">
    <inertial>
      <origin xyz="-0.064474 -0.003142 -0.056064" rpy="0 0 0"/>
      <mass value="0.410591"/>
      <inertia ixx="0.000483453" iyy="0.001103798" izz="0.000685541" ixy="-0.000027283" iyz="-0.000019795" ixz="-0.000465239"/>
    </inertial>
  </link>
  <joint name="r_knee" type="revolute">
    <parent link="r_thigh"/>
    <child link="r_shank"/>
    <origin xyz="0.091925 -0.022000 -0.077135" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.139626" upper="0.471239" effort="25.0" velocity="30.0"/>
  </joint>

  <link name="r_wheel">
